# Template for the planned Apple Silicon Mac + Colima (LaunchDaemon auto-start) configuration.
# Copy to .env locally and replace all paths/passwords before starting Immich.
# This template is not ready for the current Linux/NVIDIA compose.yml.
IMMICH_VERSION=v3.0.2
UPLOAD_LOCATION=/Volumes/<外付けSSDボリューム>/immich-upload
DB_DATA_LOCATION=/opt/immich/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-this-locally
DB_DATABASE_NAME=immich
