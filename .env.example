# Template for the planned Apple Silicon Mac + OrbStack configuration.
# Copy to .env locally and replace all paths/passwords before starting Immich.
# This template is not ready for the current Linux/NVIDIA compose.yml.
IMMICH_VERSION=v3.0.2
UPLOAD_LOCATION=/absolute/path/to/immich-upload
DB_DATA_LOCATION=/Users/<mac-user>/immich/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-this-locally
DB_DATABASE_NAME=immich
