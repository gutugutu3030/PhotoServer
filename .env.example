# Apple Silicon Mac + Colima 実行設定のテンプレート。
# このファイルを .env としてコピーし、パスワードを実値に置き換えて使う。
# compose.yml（Mac用）と組み合わせる。パスワードをこのテンプレートや文書に書かないこと。
IMMICH_VERSION=v3.0.2
UPLOAD_LOCATION=/Volumes/database4t/immich
DB_DATA_LOCATION=/opt/immich/postgres
DB_USERNAME=postgres
DB_PASSWORD=replace-this-locally
DB_DATABASE_NAME=immich
